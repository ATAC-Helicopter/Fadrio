<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fadrio.UI.ViewModels"
        x:Class="Fadrio.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="avares://fadrio/Assets/fadrio-app-icon.png"
        Width="360"
        Height="680"
        MinWidth="320"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" Spacing="12">
      <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
      <Separator />
      <TextBlock Text="{Binding OutputHeading}" FontSize="12" FontWeight="SemiBold" />
      <TextBlock Text="{Binding EmptyOutputMessage}" Opacity="0.7" />
      <Separator Margin="0,8" />
      <TextBlock Text="{Binding ApplicationsHeading}" FontSize="12" FontWeight="SemiBold" />
      <TextBlock Text="{Binding EmptyApplicationsMessage}" TextWrapping="Wrap" Opacity="0.7" />
    </StackPanel>
  </ScrollViewer>
</Window>
