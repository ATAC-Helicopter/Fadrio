<Project>
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <Using Include="Xunit" />
  </ItemGroup>
  <Target Name="CopyFadrioNativeLibrary"
          AfterTargets="Build"
          Condition="Exists('$(MSBuildThisFileDirectory)build/native/libfadrio_native.so')">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)build/native/libfadrio_native.so"
          DestinationFolder="$(OutDir)" />
  </Target>
</Project>
